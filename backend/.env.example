# BlackTrace Backend Environment Variables

# Optional: VirusTotal API key (leave blank to use simulation mode)
VIRUSTOTAL_API_KEY=

# Optional: Google Safe Browsing API key (leave blank to use simulation mode)
GOOGLE_SAFE_BROWSING_API_KEY=

# Database path (SQLite default)
DATABASE_URL=sqlite:///./blacktrace.db

# Backend port
PORT=8000
